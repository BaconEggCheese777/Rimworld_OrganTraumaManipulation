<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- Fully vanilla mechanism: a whole-body hediff whose Severity (0.00-1.00)
       is set from C# based on live organ damage. Vanilla picks whichever stage
       below matches the current severity and applies its capMods - no custom
       Hediff subclass or overrides needed. Stages are generated in 1% steps
       (0% to 100%) so the Manipulation offset always matches the severity value
       exactly, e.g. severity 0.23 -> stage "0.23" -> Manipulation offset -0.23.
       See OrganTraumaMod/GameComponent_OrganTraumaBackfill.cs for the C# side. -->
  <HediffDef>
    <defName>OrganTrauma_ManipulationPenalty</defName>
    <label>organ trauma</label>
    <description>Tracks damage to tiered internal organs and converts it into a Manipulation penalty. Only added to a pawn while that penalty is above zero.</description>
    <hediffClass>Verse.Hediff</hediffClass>
    <defaultLabelColor>(0.9, 0.5, 0.5)</defaultLabelColor>
    <isBad>true</isBad>
    <tendable>false</tendable>
    <initialSeverity>0.01</initialSeverity>
    <maxSeverity>1.0</maxSeverity>
    <scenarioCanAdd>false</scenarioCanAdd>
